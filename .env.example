# Hedera testnet signer prerequisites. Both wallets must be distinct.
HEDERA_CHAIN_ID=296
# Hashio returned HTTP 403 during the October 4 prerequisite check.
# Replace locally with a working Hedera testnet relay if needed.
HEDERA_RPC_URL=https://testnet.hashio.io/api
HBAR_USD_FEED_ADDRESS=0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a

# Populate public identifiers after confirming each wallet's role.
MERCHANT_ACCOUNT_ID=
MERCHANT_EVM_ADDRESS=
PAYER_ACCOUNT_ID=
PAYER_EVM_ADDRESS=

# Optional local EVM signing credentials; MetaMask keeps its own keys.
# Fill only in the ignored .env, never in this example or issue comments.
MERCHANT_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
